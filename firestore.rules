rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(uid) { return signedIn() && request.auth.uid == uid; }
    function isChatMember() {
      return signedIn() && request.auth.uid in resource.data.members;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMember(uid);
      allow update: if isMember(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName','photoURL']);
      allow delete: if false;
      match /earnings/{earningId} {
        allow read: if isMember(uid);
        allow write: if false;
      }
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','authorName','caption','mediaUrl','mediaType','createdAt']);
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isMember(uid) && request.resource.data.uid == uid;
        allow delete: if isMember(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt']);
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
    match /chats/{chatId} {
      allow read, create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','text','createdAt']);
        allow update, delete: if false;
      }
    }
    match /withdrawalRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','amountKobo','paymentDetails','status','createdAt']);
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Admin-only verified revenue recording and balance credits are handled by Cloud Functions.
    match /creatorRevenue/{id} { allow read, write: if false; }
  }
}